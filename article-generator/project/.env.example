DATABASE_URL=mysql+pymysql://db_user:db_password@127.0.0.1:3306/db_name
GEMINI_API_KEY=your_gemini_api_key
GNEWS_API_KEY=your_gnews_api_key
NEWSAPI_KEY=your_newsapi_key

# Public URL of this Article Generator service
GENERATOR_PUBLIC_URL=https://articlegenerator.1slabs.my.id

# Inpartner Digital Products Store integration
STORE_INTEGRATION_KEY=your_shared_integration_secret
STORE_API_URL=https://digitalproductinpartner.1slabs.my.id/api
STORE_FRONTEND_URL=https://digitalproductinpartner.1slabs.my.id

# Performance & Concurrency Controls (Shared Hosting Safe Defaults)
MAX_CONCURRENT_GENERATIONS=2
MAX_CONCURRENT_LLM_CALLS=3
MAX_GENERATION_SECONDS=240
LLM_HTTP_TIMEOUT_MS=55000
MAX_PROMPT_CHARS=36000
ENABLE_AUTO_FETCH_LOOP=false
# Enable/disable Inpartner APScheduler
ENABLE_SCHEDULER=true
AUTO_OPTIMIZE_ON_GENERATE=false

# Local 1sLabs Adapter Configuration (optional; falls back to STORE_INTEGRATION_KEY if omitted)
SLABS_INTEGRATION_KEY=your_1slabs_shared_integration_secret
SLABS_ENGINE_HOST=127.0.0.1
SLABS_ENGINE_PORT=8000

# Optional AI Image Generation Fallback Model (runs only when stock search fails & fallback enabled)
IMAGE_GEMINI_MODEL=gemini-2.5-flash-image
