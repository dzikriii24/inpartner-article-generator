# API Keys for Fallback News APIs
GNEWS_API_KEY=your_gnews_api_key_here
NEWSAPI_KEY=your_newsapi_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Database Settings
DATABASE_URL=postgresql://user:password@localhost:5432/article_generator

# Server settings example
DB_USER=your_db_user
DB_NAME=your_db_name
DB_PASSWORD=your_db_password
IP_SERVER=127.0.0.1

# Inpartner Store integration
# Shared secret - must equal ARTICLE_GENERATOR_KEY in inpartner-product/project/backend/.env
STORE_INTEGRATION_KEY=change_me_long_random_string
# Laravel store API base URL (used by "Push to Store")
STORE_API_URL=http://127.0.0.1:8001/api
# Public storefront URL (used for "View in Store" links)
STORE_FRONTEND_URL=http://localhost:5173
# Public URL of this generator app (used to absolutize /static image URLs)
GENERATOR_PUBLIC_URL=http://127.0.0.1:8000
